{
  "name": "pcag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23", "npm": ">=10 <11" },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --config vite.creator.config.ts",
    "dev:player": "vite --config vite.player.config.ts",
    "typecheck": "tsc --noEmit",
    "build:creator": "vite build --config vite.creator.config.ts",
    "build:player": "vite build --config vite.player.config.ts",
    "build": "npm run typecheck && npm run build:creator && npm run build:player",
    "preview:creator": "vite preview --config vite.creator.config.ts",
    "preview:player": "vite preview --config vite.player.config.ts",
    "test": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
